# Creative Path Inspired - Environment Variables
# Copy this file to .env.local and fill in the values

# ==============================================
# EMAIL SERVICE (Required for form submissions)
# ==============================================
# Your Gmail address used to send form notifications
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# To generate: myaccount.google.com/apppasswords
# Requires 2FA enabled on your Google account
GMAIL_APP_PASSWORD=your-16-character-app-password

# ==============================================
# OPTIONAL - Analytics & Monitoring
# ==============================================
# Vercel Analytics (automatically configured on Vercel)
# VERCEL_ANALYTICS_ID=

# ==============================================
# NOTES
# ==============================================
# 1. Never commit .env.local to version control
# 2. For production on Vercel, add these vars in:
#    Vercel Dashboard → Project Settings → Environment Variables
